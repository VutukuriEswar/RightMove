# Backend base URL used by src/lib/api.js
REACT_APP_API_URL=http://localhost:8000

# WebSocket base URL used by src/lib/api.js (createGameSocket, createMatchmakingSocket)
REACT_APP_WS_URL=ws://localhost:8000

# Dev server port (react-scripts). Must match backend FRONTEND_URL origin.
PORT=3000
GENERATE_SOURCEMAP=false