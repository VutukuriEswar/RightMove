# --- App ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=rightmove
MONGODB_CAPACITY_MB=512
MONGODB_STORAGE_THRESHOLD_PCT=75
MONGODB_MIGRATOR_INTERVAL_SECONDS=300

# --- Engines ---
SF_PATH=./engines/Stockfish/src/stockfish.exe
MAIA3_DIR=./engines/Maia-3/maia3

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Engine pool ---
ENGINE_POOL_SIZE=2               # concurrent instances per engine type
MAIA_POOL_SIZE=2                 # concurrent Maia-3 instances per Elo target

# --- Admin seed (created on startup when no admin exists) ---
ADMIN_USERNAME=EswarVutukuri
ADMIN_DISPLAY_NAME=Eswar Vutukuri
ADMIN_EMAIL=vutukurieswar@gmail.com
ADMIN_PASSWORD=change-me-in-production

# --- HuggingFace explanations (local model in backend/models/) ---
HF_EXPLANATIONS_ENABLED=true
HF_LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# --- Live broadcast events (Lichess Broadcast API, free) ---
LICHESS_TOKEN=
BROADCAST_ANALYSIS_DEPTH=12
BROADCAST_POSITION_DEPTH=18
BROADCAST_AUTO_ANALYSIS_DAILY_LIMIT=300
BROADCAST_ENGINE_HASH_MB=128